{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Achievement name"
    },
    "description": {
      "type": "string",
      "description": "What was achieved"
    },
    "type": {
      "type": "string",
      "enum": [
        "streak",
        "completion",
        "time_based",
        "milestone",
        "consistency"
      ],
      "description": "Type of achievement"
    },
    "badge": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum",
        "diamond"
      ],
      "description": "Badge level earned"
    },
    "icon": {
      "type": "string",
      "description": "Icon for the achievement"
    },
    "earned_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this achievement was earned"
    }
  },
  "required": [
    "title",
    "type",
    "badge"
  ]
}